[Unit]
Description=ravixfs data poller

[Service]
Type=oneshot
User=ravixfs
Group=ravixfs
EnvironmentFile=/etc/ravixfs.env
# Explicit DB path: /etc/ravixfs.env must NOT set RAVIXFS_DB, because
# EnvironmentFile entries override Environment= lines at exec time.
Environment=RAVIXFS_DB=/opt/ravixfs/ravixfs.db
ExecStart=/opt/ravixfs/venv/bin/python /opt/ravixfs/poller/poll.py
