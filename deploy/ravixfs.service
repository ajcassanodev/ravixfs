[Unit]
Description=ravixfs NFL Defensive Pick5 site
After=network.target

[Service]
User=ravixfs
Group=ravixfs
WorkingDirectory=/opt/ravixfs
EnvironmentFile=/etc/ravixfs.env
ExecStart=/opt/ravixfs/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
