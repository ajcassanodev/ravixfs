[Unit]
Description=ravixfs STAGING site (staging.ravixfs.com)
After=network.target

[Service]
User=ravixfs
Group=ravixfs
WorkingDirectory=/opt/ravixfs-staging
EnvironmentFile=/etc/ravixfs.env
Environment=RAVIXFS_DB=/opt/ravixfs-staging/ravixfs.db
ExecStart=/opt/ravixfs-staging/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
