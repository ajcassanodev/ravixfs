[Unit]
Description=ravixfs code sync (git pull)

[Service]
Type=oneshot
User=ravixfs
Group=ravixfs
WorkingDirectory=/opt/ravixfs
# Pull latest code; restart the app only when something changed.
ExecStart=/bin/bash -c 'BEFORE=$(git rev-parse HEAD); git pull --ff-only --quiet; AFTER=$(git rev-parse HEAD); if [ "$BEFORE" != "$AFTER" ]; then /opt/ravixfs/venv/bin/pip install -q -r requirements.txt; systemctl restart ravixfs.service; fi'
